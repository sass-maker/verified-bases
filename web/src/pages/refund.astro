---
import BaseLayout from '@/layouts/BaseLayout.astro';
const lastUpdated = '2026-08-29';
---

<BaseLayout
  title="Archive refund notice"
  description="Verified Bases is archived and does not currently accept payments or create refundable orders."
>
  <section class="container-page pt-14 pb-8 md:pt-20">
    <p class="kicker">Refund notice</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-fg sm:text-5xl text-balance">
      No live checkout means no new orders to refund.
    </h1>
    <p class="mt-3 font-mono text-xs text-faint">Last updated {lastUpdated}</p>
  </section>

  <section class="container-page max-w-3xl pb-24">
    <div class="panel-2 p-7 text-[16px] text-muted leading-relaxed text-pretty md:p-10">
      <p>
        The original refund policy is retained in Git history as part of the storefront
        prototype. This public archive does not accept payment, create orders, or provision
        paid deliverables. If you believe you have a historical payment issue, email
        <a class="link text-accent" href="mailto:sarthakagrawal927@gmail.com">sarthakagrawal927@gmail.com</a>
        with the date and payment reference so it can be investigated directly.
      </p>
    </div>
  </section>
</BaseLayout>
