---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Submissions closed"
  description="Verified Bases is archived. Marketplace submissions and paid listings are not open."
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-50" aria-hidden="true"></div>
    <div class="relative container-page py-20 md:py-28">
      <p class="kicker">Archive status</p>
      <h1 class="mt-3 max-w-3xl text-[2rem] font-semibold leading-[1.05] tracking-[-0.02em] text-fg sm:text-5xl text-balance">
        Marketplace submissions are closed.
      </h1>
      <p class="mt-6 max-w-2xl text-[16px] text-muted leading-relaxed text-pretty">
        Verified Bases did not validate enough buyer demand or support economics to
        operate as a marketplace. The original intake workflow is preserved in Git
        history, but this archive does not collect listing proposals or promise replies,
        verification, payouts, or publication.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/about" class="btn btn-primary">Read the archived thesis →</a>
        <a href="/trust" class="btn btn-ghost">Inspect the verification standard</a>
      </div>
    </div>
  </section>
</BaseLayout>
